# AI Career Coach - Environment Configuration
# Copy this file to .env.local and fill in your values

# AI Provider Configuration
# Supported: openai, azure, compatible (any OpenAI-compatible API)
AI_PROVIDER=openai

# API Key for your AI provider
# Get one from: https://platform.openai.com/api-keys
AI_API_KEY=your-api-key-here

# Model name (default: gpt-4o-mini for cost efficiency)
AI_MODEL=gpt-4o-mini

# Optional: Custom API base URL (for Azure or compatible providers)
# AI_API_BASE=https://your-endpoint.openai.azure.com/

# Flask Configuration
FLASK_SECRET_KEY=change-this-to-a-random-string
FLASK_PORT=3000
FLASK_DEBUG=false
